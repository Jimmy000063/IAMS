# Backend configuration. Copy to `backend/.env` and adjust.
#   Copy-Item .env.example .env
#
# Every variable is prefixed IAMS_. Business policy (leave year, grace periods,
# statutory rates) is NOT configured here - it lives in the database as
# `system_settings` rows, editable by HR/Admin without a redeploy.

# --- application -------------------------------------------------------------
IAMS_APP_ENV=local
IAMS_DEBUG=false
IAMS_DOCS_ENABLED=true

# --- database ----------------------------------------------------------------
# A locally installed PostgreSQL on its default port, set up by
# `infra/postgres/local-setup.sql`. (If you run the optional
# docker-compose database instead, change the port to 5433 and the user to
# `iams`.)
#
# `iams_owner` is used in local development because migrations and the
# application run from the same place. A deployment should point this at
# `iams_app` and run `alembic upgrade` separately as the owner - that is what
# makes the migrations' DELETE revocations take effect.
IAMS_DATABASE_URL=postgresql+psycopg://iams_owner:iams_local_dev@localhost:5432/iams
IAMS_DB_ECHO=false

# --- security ----------------------------------------------------------------
# Generate a real key before any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Startup fails in production if this is left at the development default.
IAMS_SECRET_KEY=dev-only-insecure-secret-change-me

IAMS_ACCESS_TOKEN_TTL_MINUTES=30
IAMS_REFRESH_TOKEN_TTL_DAYS=14

# Argon2id cost parameters. Raise memory_cost on capable hardware; verify with
# `iams benchmark-hash` that a single hash stays near 0.1-0.5 seconds.
IAMS_ARGON2_TIME_COST=3
IAMS_ARGON2_MEMORY_COST_KIB=65536
IAMS_ARGON2_PARALLELISM=2

# Failed sign-in throttling.
IAMS_LOGIN_MAX_ATTEMPTS=5
IAMS_LOGIN_LOCKOUT_MINUTES=15
IAMS_LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Field-level encryption for bank account numbers and PAN. Generate with:
#   python -m app.cli generate-encryption-key
# Without it, bank and statutory details cannot be stored - the API refuses the
# request rather than writing plaintext. Back this key up SEPARATELY from the
# database: losing it means those fields can never be read again. It is
# deliberately not derived from IAMS_SECRET_KEY, so rotating the token-signing
# key stays a routine operation.
IAMS_FIELD_ENCRYPTION_KEY=

# Previous keys, comma-separated, tried on decrypt only. Lets a key be rotated
# without downtime: add the old key here, set the new one above, run
# `python -m app.cli rotate-encryption-key --confirm`, then remove it.
IAMS_FIELD_ENCRYPTION_KEYS_RETIRED=

# --- file uploads ------------------------------------------------------------
# Employment documents. Relative to the backend directory; gitignored.
IAMS_STORAGE_DIR=storage
IAMS_MAX_UPLOAD_BYTES=10485760

# --- web ---------------------------------------------------------------------
# Comma-separated. A wildcard is rejected in production because credentials are
# allowed on cross-origin requests.
IAMS_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- behaviour ---------------------------------------------------------------
# Fallback only. Attendance dates use the employee's work-location timezone.
IAMS_DEFAULT_TIMEZONE=Asia/Kolkata
