# OPTIONAL: settings for the docker-compose PostgreSQL containers.
#
# The project's default database is a locally installed PostgreSQL on 5432,
# configured in `backend/.env`. This file is only read by docker-compose, which
# is now an alternative rather than the default.
# Copy to `.env` in this directory: `Copy-Item .env.example .env`
#
# These credentials are for local development only. Generate new ones for any
# shared or deployed environment, and never commit the resulting `.env`.

# Leaving a value empty makes docker-compose.yml fall back to its built-in local
# default (database `iams`, user `iams`, password `iams_local_dev`), which is
# enough to get a development database running.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Published host ports. 5433/5434 avoid colliding with a PostgreSQL already
# installed on the host's default 5432.
POSTGRES_PORT=5433
POSTGRES_TEST_PORT=5434
