# Frontend configuration. Copy to `frontend/.env.local` if you need to override.
#
# Nothing secret belongs in this file: Vite inlines every VITE_* variable into
# the JavaScript bundle, which is public.

# API base path. Leave unset in development: requests go to /api/v1 and
# vite.config.ts proxies them to the backend, so the browser sees one origin.
# VITE_API_BASE_URL=/api/v1

# Where the dev server proxies /api and /health. Defaults to localhost:8001.
# VITE_API_PROXY_TARGET=http://localhost:8001
